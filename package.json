{
  "name": "dsh-observer",
  "version": "1.0.0",
  "description": "Companion session (鍓剳) for DSH: a follower session bound to a main session, co-transferring by pointer, never sliced.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./manifest": "./manifest.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5",
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "manifest.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
