{
  "name": "@corvus-dsh/dsh-observer",
  "version": "0.9.2-beta.1",
  "description": "星火 OS 副脑 (observer): a companion session bound to a main session, co-transferring by pointer, never sliced. Watches for stuck loops and can inject a corrective interruption.",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./manifest": "./manifest.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5",
    "node": ">=22.5.0"
  },
  "peerDependencies": {
    "@corvus-dsh/dsh-paradise": "^0.9.0-beta.1"
  },
  "peerDependenciesMeta": {
    "@corvus-dsh/dsh-paradise": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check": "node scripts/build.mjs && node scripts/preflight.mjs && node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "manifest.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvus-dsh/dsh-observer.git"
  },
  "homepage": "https://github.com/corvus-dsh/dsh-observer#readme",
  "bugs": {
    "url": "https://github.com/corvus-dsh/dsh-observer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "observer",
    "companion-session",
    "starfire"
  ]
}
